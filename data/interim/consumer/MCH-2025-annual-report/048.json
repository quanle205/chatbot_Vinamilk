[[0.02499996325231694,0.11981920139935182,0.1122503546151415,0.14995230150739,"Caring for the",1],[0.02499996325231694,0.15510506162586452,0.10700719519634291,0.1852381617339027,"Environment",1],[0.10854398330185283,0.15510506162586452,0.13298192748947177,0.1852381617339027,"and",1],[0.02499996325231694,0.1903909218523772,0.11131622851179235,0.22052402196041537,"Communities",1],[0.17573859168179443,0.12349396970521014,0.24847401571330924,0.1440726722180167,"Climate change",1],[0.17573859168179443,0.15509697713559165,0.2694882885134094,0.1675911893755099,"Greenhouse Gas (GHG) Emissions",1],[0.17573859168179443,0.17861108457111777,0.30063635962752544,0.19110529681103605,"We continue to regularly monitor and manage",1],[0.17573859168179443,0.1962529122538823,0.2976502429021849,0.20874712449380056,"greenhouse gas (GHG) emissions across our",1],[0.17573859168179443,0.21389473993664682,0.31114461683190864,0.2263889521765651,"operations to support compliance with regulatory",1],[0.17573859168179443,0.23153656761941135,0.3148104187031008,0.24403077985932964,"requirements and internal sustainability objectives.",1],[0.17573859168179443,0.24917839530217598,0.3258677965354284,0.26167260754209426,"Emissions data are collected and reviewed periodically",1],[0.17573859168179443,0.26682022298494057,0.3241448446675437,0.2793144352248589,"to track performance, identify major emission sources,",1],[0.17573859168179443,0.2844620506677052,0.31980935302029195,0.29695626290762345,"and support informed decision-making on mitigation",1],[0.17573859168179443,0.3021038783504698,0.3191783953021761,0.31459809059038807,"measures.. While Scope 1 emissions declined thanks",1],[0.17573859168179443,0.31974570603323443,0.308801952036924,0.3322399182731527,"to our transition from diesel-powered equipment",1],[0.17573859168179443,0.33738753371599906,0.3025979509491926,0.3498817459559173,"to electricity-based alternatives, the additional",1],[0.17573859168179443,0.3550293613987637,0.324538412353101,0.36752357363868193,"electricity demand for automated systems contributed",1],[0.17573859168179443,0.3726711890815283,0.3109746955454457,0.38516540132144655,"to an increase in Scope 2 emissions. Our ongoing",1],[0.17573859168179443,0.39031301676429286,0.3121435291004901,0.4028072290042112,"transition to renewable electricity through rooftop",1],[0.17573859168179443,0.4079548444470575,0.3139358238463064,0.4204490566869758,"solar installations helped partly offset this rise. The",1],[0.17573859168179443,0.4255966721298221,0.30708337314332323,0.43809088436974036,"renewable electricity added in 2025 was not yet",1],[0.17573859168179443,0.44323849981258673,0.32601272939741144,0.455732712052505,"sufficient to fully counterbalance the higher grid-based",1],[0.17573859168179443,0.46088032749535135,0.3141800856955968,0.4733745397352696,"electricity consumption. As we continue to expand",1],[0.17573859168179443,0.47852215517811597,0.3226892689415932,0.4910163674180342,"the use of renewable electricity and energy-efficiency",1],[0.17573859168179443,0.4961639828608806,0.3246377413404084,0.5086581951007988,"measures in the coming years, we expect these efforts",1],[0.17573859168179443,0.5138058105436452,0.3077880467136546,0.5263000227835635,"to contribute more significantly to reducing total",1],[0.17573859168179443,0.5314476382264098,0.2792968698323569,0.543941850466328,"Scope 1 and Scope 2 GHG emissions.",1],[0.5354166819782012,0.16977444272138653,0.559880349543961,0.18226865496130482,"Emission",1],[0.5354166819782012,0.18741627040415107,0.5604488362008774,0.19991048264406933,"Category",1],[0.5904224513644414,0.17565921668638793,0.6375881025701325,0.18815342892630618,"Emission sources",1],[0.7585320770525418,0.16390216296862478,0.7922233450680932,0.17639637520854304,"Unit (tCO2e)",1],[0.8837615663332427,0.16978693693362631,0.9700341018498778,0.1822811491735446,"% Increase/Decrease compared",1],[0.9318018123957285,0.18742876461639085,0.970034101849878,0.19992297685630914,"2023 bas