[[0.1760072907403188,0.12569883068872512,0.2774290585978556,0.1381930429286434,"GHG Emissions Reduction Initiatives",1],[0.1760072907403188,0.14921293812425124,0.29383458397947987,0.16170715036416952,"We have committed to achieving Net Zero",1],[0.1760072907403188,0.16685476580701578,0.2979882848386406,0.17934897804693406,"emissions goal by 2050. To realize this goal,",1],[0.1760072907403188,0.18449659348978031,0.29277944775581877,0.19699080572969857,"the Company has implemented a range of",1],[0.1760072907403188,0.20213842117254482,0.301436687416858,0.2146326334124631,"comprehensive solutions, including reducing",1],[0.1760072907403188,0.21978024885530936,0.3147798813784787,0.23227446109522765,"fossil fuel consumption in production, investing in",1],[0.1760072907403188,0.23742207653807398,0.30900818003424857,0.24991628877799227,"renewable energy, enhancing energy efficiency,",1],[0.1760072907403188,0.2550639042208386,0.31246970153531783,0.2675581164607569,"and increasing the application of automation and",1],[0.1760072907403188,0.2727057319036032,0.32200840786988355,0.28519994414352146,"digital control systems. The 2025 key GHG emission",1],[0.1760072907403188,0.2903475595863678,0.25855655100945857,0.3028417718262861,"reduction initiatives included:",1],[0.326712478778213,0.1257238191132047,0.44917949773266735,0.13821803135312297,"Energy Consumption within the organization",1],[0.326712478778213,0.14923792654873083,0.46289127095536625,0.1617321387886491,"Given that the Company’s market share continues",1],[0.326712478778213,0.16687975423149534,0.4422708230746051,0.17937396647141363,"to grow, we are expanding production and",1],[0.326712478778213,0.18452158191425988,0.45153590616111655,0.19701579415417816,"business activities and enhancing operational",1],[0.326712478778213,0.20216340959702442,0.46184987836516916,0.2146576218369427,"efficiency through greater automation and the full",1],[0.326712478778213,0.21980523727978896,0.4526522640247531,0.2322994495197072,"digitalization of every production line to better",1],[0.326712478778213,0.23744706496255355,0.44858040025576384,0.24994127720247183,"respond to increasing market demand. MCH",1],[0.326712478778213,0.2550888926453182,0.4516864614186076,0.26758310488523646,"therefore needs a variety of energy sources to",1],[0.326712478778213,0.27273072032808277,0.4552323188522963,0.2852249325680011,"support our production activities. In 2025, total",1],[0.326712478778213,0.2903725480108474,0.46669638329303353,0.3028667602507657,"energy consumption increased moderately by 6.5%",1],[0.326712478778213,0.308014375693612,0.46637903030213956,0.32050858793353026,"compared with the 2023 baseline, largely driven by",1],[0.326712478778213,0.32565620337637663,0.4603818084269787,0.3381504156162949,"a 12.94% rise in production volumes. Despite this",1],[0.326712478778213,0.34329803105914125,0.46673511535097717,0.3557922432990595,"growth, Masan Consumer continued to advance its",1],[0.326712478778213,0.3609398587419059,0.46370526888279706,0.37343407098182413,"clean-energy transition. The commissioning of our",1],[0.326712478778213,0.3785816864246705,0.4575574917501453,0.39107589866458875,"535.5 kWp rooftop solar system helped partially",1],[0.326712478778213,0.3962235141074351,0.45593949126507566,0.40871772634735337,"offset higher energy demand and strengthened",1],[0.326712478778213,0.4138653417901997,0.45732010171758664,0.426359554030118,"our shift toward low-carbon, on-site generation.",1],[0.326712478778213,0.4315071694729643,0.45361556778845097,0.4440013817128826,"However, the share of renewable energy in our",1],[0.326712478778213,0.4491489971557289,0.4597620954998787,0.4616432093956472,"total energy mix decreased compared with 2023",1],[0.326712478778213,0.46679082483849355,0.444595371261842,0.4792850370784118,"due to a shortage of biomass supply, which",1],[0.326712478778213,0.48443265252125817,0.45316640085842586,0.4969268647611764,"required some facilities to rely more heavily on",1],[0.326712478778213,0.5020744802040228,0.46664078404856574,0.5145686924439411,"fossil fuels during periods of constrained feedstock",1],[0.326712478778213,0.5197163078867874,0.4524411118378986,0.5322105201267057,"availability. Consequently, absolute renewable",1],[0.326712478778213,0.537358135569552,0.4531707738327098,0.5498523478094702,"energy consumption fell by 7.5% relative to the",1],[0.326712478778213,0.5549999632523166,0.45778863467658376,0.5674941754922349,"2023 baseline, resulting in a lower proportion of",1],[0.326712478778213,0.5726417909350813,0.451929473846674,0.5851360031749995,"renewables in the overall energy mix. Even so,",1],[0.326712478778213,0.5902836186178458,0.4572457611547593,0.6027778308577642,"renewable sources—including rooftop solar and",1],[0.326712478778213,0.6079254463006105,0.46294936904228196,0.6204196585405287,"biomass—continued to contribute meaningfully to",1],[0.326712478778213,0.6255672739833751,0.46718490699161414,0.6380614862232934,"our operations. We remain committed to expanding",1],[0.326712478778213,0.6432091016661396,0.4426900038952545,0.655703313906058,"renewable capacity and enhancing energy",1],[0.326712478778213,0.6608509293489043,0.4591573756274667,0.6733451415888225,"efficiency to support long-term decarbonization.",1],[0.18395831342833835,0.32657857022114767,0.2883774428022313,0.3390727824610659,"Maintaining the transition from diesel-",1],[0.18395831342833835,0.3412717638152915,0.30285948420952047,0.35376597605520976,"powered forklifts into 100% electric forklifts",1],[0.18395831342833835,0.35596495740943535,0.3040776699029125,0.36845916964935366,"in one of our production plants, which could",1],[0.18395831342833835,0.37065815100357924,0.30708815034212084,0.3831523632434975,"potentially reduce CO2 emissions from using",1],[0.18395831342833835,0.3853513445977231,0.24987715249553513,0.3978455568376414,"electric forklifts by 66%.",1],[0.18418952985014292,0.43912217134709663,0.29641254418908924,0.4516163835870149,"Rolling out a biomass steam consumption",1],[0.18418952985014292,0.4538153649412405,0.3084007408332909,0.46630957718115873,"reduction initiative across our processing lines",1],[0.18418952985014292,0.4685085585353843,0.2960876946708513,0.4810027707753026,"to improve energy efficiency and optimize",1],[0.18418952985014292,0.4832017521295282,0.2934932714992323,0.49569596436944646,"thermal performance. By enhancing heat",1],[0.18418952985014292,0.49789494572367204,0.30771230973887126,0.5103891579635903,"transfer conditions, refining steam distribution",1],[0.18418952985014292,0.5125881393178159,0.2905839941791673,0.5250823515577342,"settings, and improving insulation along",1],[0.18418952985014292,0.5272813329119598,0.3028077067240913,0.5397755451518781,"critical equipment, the system now achieves",1],[0.18418952985014292,0.5419745265061037,0.3084750813961183,0.5544687387460219,"faster thermal response times and more stable",1],[0.18418952985014292,0.5566677201002475,0.29490011979744707,0.5691619323401658,"operating temperatures, and reduces fuel",1],[0.18418952985014292,0.5713609136943913,0.30962954660708675,0.5838551259343097,"costs by ~25 kg of steam/hour/line. In addition,",1],[0.18418952985014292,0.5860541072885352,0.3033462072716318,0.5985483195284534,"the initiative reduced steam usage per ton of",1],[0.18418952985014292,0.600747300882679,0.3046331111323435,0.6132415131225973,"product by 70–80 kg/ hour/ line, contributing",1],[0.18418952985014292,0.615440494476823,0.3093665434394365,0.6279347067167413,"to more efficient resource use, lower operating",1],[0.18418952985014292,0.6301336880709669,0.30633794639248024,0.6426279003108851,"expenses, and reduced environmental impact",1],[0.18418952985014292,0.6448268816651107,0.2746913562099912,0.657321093905029,"across our production operations.",1],[0.5312475103444727,0.40196438414557945,0.632082050226733,0.4144585963854977,"Proportion of energy mix by sources",1],[0.6446798174375106,0.13665537287874,0.6565243306409531,0.149149