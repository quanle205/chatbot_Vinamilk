45550223058,0.628385380301772,0.3542076097102077,0.6408795925416902,"ºÚÀÄ",1],[0.40300169774295724,0.628385380301772,0.41424648875888365,0.6408795925416902,"×¾×",1],[0.4592925336057561,0.628385380301772,0.46678906094970707,0.6408795925416902,"ºÄ",1],[0.027080249590263297,0.6577842617022996,0.0467086570191749,0.670278473942218,"TOTAL",1],[0.16646568133879155,0.6577842617022996,0.18520699969866897,0.670278473942218,"»²μ»¶",1],[0.21901009091376786,0.6577842617022996,0.24149967294562077,0.670278473942218,"»¸¸Ë¸Ì",1],[0.27916972284897434,0.6577842617022996,0.29791104120885176,0.670278473942218,"»²´μ¶",1],[0.33171413242395065,0.6577842617022996,0.3542037144558035,0.670278473942218,"»¸¸Ë¸Ì",1],[0.3917571272131292,0.6577835267486385,0.41424670924498214,0.6702777389885568,"»²±»μÆ",1],[0.45179615325253736,0.6577835267486385,0.46678920794043927,0.6702777389885568,"»¸¸Ì",1],[0.025006357349169145,0.12570500429947892,0.19346519626937525,0.13819921653939718,"Table 26: Labor structure of the Company (Parent Company)",1],[0.025000036747683054,0.6923481034520773,0.1124996508970109,0.7026374547084806,"Source: Masan Consumer Corporation",1],[0.02477065771003138,0.7232163042120194,0.1193503744588904,0.743795006724826,"Working conditions",1],[0.025279539625026638,0.7548193116424011,0.24058980031309038,0.7673135238823193,"Working hours and rest periods for employees at Masan Group Corporation",1],[0.02521082145770709,0.7724611393251656,0.23066502282031134,0.7849553515650839,"comply with the provisions of the Labor Code. Employees are entitled to",1],[0.02532326936786635,0.7901029670079301,0.23356992716609226,0.8025971792478485,"public holidays and annual leave in accordance with current laws and the",1],[0.02517958592710729,0.8077447946906948,0.22617210409883662,0.8202390069306131,"Collective Labor Agreement. Employees are provided with appropriate",1],[0.0253919875351859,0.8253866223734594,0.18850267890609487,0.8378808346133776,"working equipment and allowances as prescribed by law.",1],[0.25090627135959076,0.7548318058546408,0.44056341547665434,0.7673260180945591,"The Company regularly upgrades office facilities, integrates modern",1],[0.2514934993348669,0.7724736335374056,0.46668881327032363,0.7849678457773238,"equipment, and provides comprehensive personal protective equipment. The",1],[0.2514934993348669,0.7901154612201701,0.4675065594614262,0.8026096734600884,"company affirms our commitment to building a professional and friendly work",1],[0.2514934993348669,0.8077572889029347,0.45312072348838417,0.8202515011428531,"environment that fosters the productivity and creativity of all employees.",1],[0.5300549010384895,0.11173471112646352,0.59700668072878,0.1323134136392701,"Training policy",1],[0.5308689357136032,0.14333771855684505,0.7476672570794416,0.1558319307967633,"The Company maintains a robust training policy and applies fair and reasonable",1],[0.5315686115990387,0.16097954623960956,0.7216118268743156,0.17347375847952784,"recognition and reward mechanisms, commensurate with employees’",1],[0.5314561636888794,0.1786213739223741,0.7408023121642181,0.19111558616229238,"capabilities and contributions to the Company’s development. The Company",1],[0.5314436694766393,0.19626320160513863,0.736547408185914,0.2087574138450569,"aligns training initiatives with employee development and actively supports",1],[0.5314561636888794,0.21390502928790317,0.7441944907873559,0.22639924152782143,"employees’ participation in both in-house and external training programs. This",1],[0.5317060479336777,0.23154685697066768,0.7416837788377446,0.24404106921058596,"initiative aims to enhance professional skills, acquire new skill sets necessary",1],[0.5316060942357584,0.2491886846534323,0.7271586323982274,0.26168289689335056,"for current and future job requirements, and contribute to the long-term",1],[0.5314998934317191,0.2668305123361969,0.7333670064602429,0.2793247245761152,"success of the Company. Course programs and content are tailored to the",1],[0.5315686115990387,0.28447234001896154,0.7255043986976625,0.2969665522588798,"proficiency levels and learning needs of individual employees, ensuring",1],[0.5314436694766395,0.30211416770172617,0.7211745294459184,0.3146083799416444,"alignment with the Company’s expectations while cultivating the next",1],[0.5314499165827594,0.31975599538449073,0.5909848379059702,0.33225020762440904,"generation of leaders.",1],[0.5308689357136033,0.35503965075002,0.7223364911842313,0.3675338629899383,"The Company’s talent development strategy is built on a foundation of",1],[0.5316185884479984,0.3726814784327846,0.7266532415131229,0.38517569067270285,"transparency and clarity, including several key pillars. Such as providing",1],[0.5314624107949995,0.3903233061155492,0.7475435643782663,0.4028175183554675,"employees with opportunities to gain valuable experience and leadership skills,",1],[0.5314624107949995,0.40796513379831384,0.7334550906565344,0.4204593460382321,"competency-based performance evaluations, delivering regular training in",1],[0.5316185884479984,0.42560696148107846,0.7424709142088598,0.4381011737209967,"technical, professional, and soft skills, and ensuring a high quality of life for all",1],[0.5314624107949995,0.4432487891638431,0.7429388224572443,0.45574300140376134,"employees. Furthermore, long-term training blueprints have been established",1],[0.5316185884479984,0.46089061684660765,0.7044878842888959,0.47338482908652596,"to prepare high-potential employees for future leadership roles.",1],[0.5308689357136033,0.4961742722121369,0.7240788090810876,0.5086684844520551,"The Company also conducts regular training on appropriate workplace",1],[0.531668565296958,0.5138160998949015,0.7242143712838908,0.5263103121348198,"behaviors to ensure personal and collective safety and encourages the",1],[0.5314499165827594,0.5314579275776661,0.7402650610379018,0.5439521398175844,"application of this knowledge in daily life. In addition, the company organizes",1],[0.5315436231745588,0.5490997552604308,0.7406761206205953,0.5615939675003491,"various training sessions on occupational safety, fire prevention, first aid, and",1],[0.5316435768724782,0.5667415829431953,0.6727950655211192,0.5792357951831136,"workplace accidents prevention for employees, etc.",1],[0.5314175051263017,0.5997439421444478,0.7257082380955878,0.6203226446572544,"Salary, bonus, allowance/benefits policies",1],[0.5316688592784224,0.6313469495748293,0.5496667720100248,0.6438411618147476,"Salary",1],[0.5497292430712243,0.6313469495748293,0.7167906043523964,0.6438411618147476,": The Company pays our employees based on their job level,",1],[0.5314564576703438,0.648988777257594,0.7299526322365388,0.6614829894975123,"competency, position, salary scale, and the Company's overall business",1],[0.5314564576703438,0.6666306049403585,0.7455953859609165,0.6791248171802768,"conditions. Employee salaries are not lower than the regional minimum wage",1],[0.5315001874131835,0.6842724326231232,0.7318330111786464,0.6967666448630415,"stipulated by the State. Actual monthly salary is calculated based on the",1],[0.5315001874131835,0.7019142603058878,0.7400560769643485,0.7144084725458061,"salary agreed in the Employment contract, other allowances and additional",1],[0.5315689055805031,0.7195560879886524,0.7250105465850389,0.7320503002285708,"payments (if any), mandatory contributions to social insurance, health",1],[0.5317125890212621,0.737197915671417,0.7378545967676751,0.7496921279113352,"insurance, unemployment insurance, personal income tax as stipulated by",1],[0.5317563187641018,0.7548397433541817,0.7483122524124861,0.7673339555941,"law, and the number of working days and leave days shown on the employee's",1],[0.5315689055805031,0.7724815710369463,0.7387304410456932,0.7849757832768645,"monthly attendance record. Employees who work overtime are paid based",1],[0.5314564576703438,0.7901233987197109,0.736324055768285,0.8026176109596292,"on the employee’s current job salary in accordance with legal regulations.",1],[0.531556411368263,0.8077652264024755,0.7346698220677192,0.8202594386423937,"Employees who work at night are entitled to at least an additional 30% of",1],[0.5316126353233427,0.82540705408524,0.7439417769709631,0.8379012663251583,"the normal daily wage. Employees who work overtime at night, in addition to",1],[0.5315001874131834,0.8430488817680046,0.7414341885744115,0.8555430940079229,"statutory overtime pay, are also entitled to an additional 20% of the daytime",1],[0.5316126353233427,0.8606907094507692,0.7349072121002781,0.8731849216906875,"job. The Company conducts annual salary reviews for our employees and",1],[0.5314564576703438,0.8783325371335339,0.694706459507729,0.8908267493734522,"consistently pays attention to their income and well-being.",1],[0.7579327958372223,0.1257436628620567,0.775555882201627,0.13823787510197497,"Bonus",1],[0.7754934111404271,0.1257436628620567,0.9480197408553374,0.13823787510197497,": In order to encourage and motivate employees to enhance their",1],[0.7578515834576628,0.14338549054482122,0.9561890815284079,0.1558797027847395,"performance and contributions, the Company implements practical bonus",1],[0.7577266413352636,0.16102731822758576,0.9671265149232328,0.17352153046750404,"and benefit policies. The policy includes quarterly reward schemes and ad hoc",1],[0.7579452900494621,0.1786691459103503,0.9748054577658857,0.19116335815026855,"bonuses for individuals and teams with outstanding achievements. The Company",1],[0.7577328884413834,0.19631097359311483,0.9662781579121419,0.2088051858330331,"grants timely and appropriate rewards to encourage initiatives, improvements,",1],[0.7579452900494621,0.21395280127587935,0.9513488237066636,0.22644701351579763,"higher work efficiency, cost savings, and enhanced our competitiveness.",1],[0.7574892513027051,0.2492364566414086,0.8271257432218891,0.26173066888132684,"Allowances and Support:",1],[0.8284626239315597,0.2492364566414086,0.9414153002653158,0.26173066888132684,"Based on business characteristics and job",1],[0.7578515834576627,0.2668782843241732,0.964272212137023,0.27937249656409147,"requirements, and on a case-by-case basis, the Company considers supports",1],[0.7577266413352634,0.28452011200693783,0.9606720048800905,0.2970143242468561,"and or allowances for individual employees to facilitate their work, including:",1],[0.7577079000169036,0.30216193968970245,0.9656147152422024,0.3146561519296207,"Concurrent duty allowance, promotion responsibility allowance, responsibility",1],[0.7577266413352634,0.319803767372467,0.946125618279766,0.33229797961238533,"allowance, hazardous duty allowance, special allowance, meal support",1],[0.7577391355475034,0.33744559505523164,0.9640054607057005,0.34993980729514995,"during shifts, transportation support, housing support, phone allowance, etc.,",1],[0.7577391355475034,0.35508742273799626,0.896718505398233,0.3675816349779145,"depending on working conditions and job positions.",1],[0.7579265487311022,0.3903710781035255,0.822439164210696,0.40286529034344376,"Insurance and benefits:",1],[0.8235761375245282,0.3903710781035255,0.9693448623064295,0.40286529034344376,"The Company fully participates in social insurance and",1],[0.7579515371555822,0.4080129057862901,0.9739058744846119,0.4205071180262084,"health insurance schemes for all employees. In addition, the Company purchases",1],[0.7577328884413836,0.42565473346905475,0.9585205015323769,0.438148945708973,"accident insurance for all employees and health insurance for employees at",1],[0.7577891123964632,0.4432965611518193,0.9657277878629733,0.4557907733917376,"specialist level and above, providing healthcare through leading domestic and",1],[0.7579952668984219,0.46093838883458393,0.9682916002146048,0.47343260107450225,"international hospital systems in Vietnam. Each year, the Company coordinates",1],[0.7579265487311023,0.47858021651734856,0.9517099064403975,0.49107442875726687,"with the Trade Union to organize at least one vacation trip for employees.",1],[0.7