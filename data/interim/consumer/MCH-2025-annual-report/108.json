[[0.02499996325231694,0.11393986609144308,0.10634426699396604,0.14407296619948126,"Governance",1],[0.02499996325231694,0.14922572631795578,0.11750858058399416,0.17935882642599396,"Structure and",1],[0.02499996325231694,0.18451158654446845,0.13108354218266535,0.21464468665250663,"Management of",1],[0.02499996325231694,0.21979744677098115,0.1428806508749623,0.24993054687901933,"Masan Consumer",1],[0.02499996325231694,0.2550833069974938,0.10596760324261553,0.28521640710553203,"Corporation",1],[0.17616758413382036,0.12569883068872512,0.46140982486054266,0.1381930429286434,"Masan Consumer Corporation is organized and operates in accordance with the Law on Enterprises",1],[0.1760551362236611,0.14334065837148965,0.45970936257468975,0.1558348706114079,"approved by the National Assembly of the Socialist Republic of Vietnam. The Company's operations",1],[0.176067630435901,0.1609824860542542,0.4544043200576206,0.17347669829417245,"comply with the Law on Enterprises, the Law on Securities, and other relevant laws, as well as the",1],[0.17603639490530124,0.1786243137370187,0.4556849768122121,0.191118525976937,"Company Charter unanimously approved by the General Meeting of Shareholders. The Company’s",1],[0.17618007834606028,0.19626614141978324,0.30264711934912536,0.20876035365970153,"management structure in 2025 is as follows:",1],[0.17600177858786,0.5997440891351801,0.33566987351447447,0.6203227916479866,"General Meeting of Shareholders",1],[0.17547525778499665,0.6313470965655615,0.46223492058825705,0.6438413088054799,"The General Meeting of Shareholders (GMS) comprises all shareholders with voting rights and is the",1],[0.1762748873683514,0.6489889242483262,0.45883711956961126,0.6614831364882445,"highest decision making authority of the Company. The GMS decides on matters prescribed by law",1],[0.17605623865415282,0.6666307519310908,0.2555069342877932,0.6791249641710091,"and the Company’s Charter.",1],[0.17548150489111658,0.6901448593666171,0.4582817518355471,0.7026390716065353,"The annual GMS is convened once each year. In addition to the annual meeting, extraordinary GMS",1],[0.176181180776552,0.7077866870493816,0.46345935338776906,0.7202808992893,"meetings may be convened as required. The venue of a GMS meeting shall be the location where the",1],[0.17606873286639274,0.7254285147321463,0.45962862791501,0.7379227269720645,"chairperson attends the meeting and must be within the territory of Vietnam. The annual GMS must",1],[0.1762748873683514,0.743070342414911,0.45093140677480315,0.7555645546548292,"be held within four (04) months from the end of the financial year. Where necessary, the Board of",1],[0.1761686865643121,0.7607121700976754,0.46505299015897034,0.7732063823375938,"Directors may decide to extend the time limit for convening the annual GMS, but such extension shall",1],[0.17617493367043205,0.77835399778044,0.3499050807346602,0.7908482100203583,"not exceed six (06) months from the end of the financial year.",1],[0.17585618426758193,0.2234478146152885,0.45015926445837584,0.23814688783872176,"Figure 3: Governance Structure and Management of Masan Consumer Corporation",1],[0.3824890675642901,0.3887753467143897,0.4296922014067013,0.40126955895430794,"Audit Committee",1],[0.20657724730455743,0.5004885971939469,0.26814872522287453,0.5129828094338652,"Board of Management",1],[0.21224322556462813,0.3887753467143897,0.2624818282707274,0.40126955895430794,"Board of Directors",1],[0.1917781468878387,0.27706268419776137,0.28294653947068626,0.2895568964376796,"General Meeting of Shareholders",1],[0.17585618426758193,0.5629962590858646,0.26335579841690976,0.5732856103422679,"Source: Masan Consumer Corporation",1],[0.6822896011406481,0.11761434041583682,0.7709107545769238,0.1381930429286434,"Board of Directors",1],[0.6817251567288681,0.14921734784621835,0.9638107347331786,0.1617115600861366,"The Board of Directors (BOD) is the governing body of the Company and has full authority to act on",1],[0.6825247863122229,0.16685917552898286,0.9704576556448152,0.17935338776890114,"behalf of the Company to decide and exercise the Company’s rights and obligations, except for those",1],[0.6824685623571433,0.1845010032117474,0.9662908358628016,0.19699521545166568,"falling within the authority of the GMS. The BOD approves resolutions and decisions through voting",1],[0.6823061375980244,0.20214283089451193,0.9708899553883154,0.2146370431344302,"at meetings or by collecting written opinions. Each BOD member has one vote. The BOD may adopt a",1],[0.6824310797204235,0.21978465857727647,0.9732082564694332,0.23227887081719473,"resolution to authorize the Chairman of the BOD to act on our behalf in making decisions or exercising",1],[0.682362361553104,0.23742648626004106,0.88655527219009,0.24992069849995935,"specific rights and obligations as prescribed by the Company’s Charter.",1],[0.6817251567288681,0.26094059369556727,0.9646790824838523,0.2734348059354856,"The BOD of Masan Consumer Corporation currently consists of 06 members. Members of the BOD",1],[0.6822998904919044,0.2785824213783319,0.9574399359120438,0.29107663361825015,"are elected and dismissed by the GMS. The BOD is responsible for supervising and directing the",1],[0.6822811491735445,0.2962242490610965,0.9741453223874271,0.30871846130101477,"Company’s business activities and affairs, and has the authority to appoint key management personnel",1],[0.6822998904919044,0.31386607674386113,0.9559181408612222,0.3263602889837794,"as well as the responsibility to supervise their performance. The Chairman of the BOD is elected",1],[0.6822998904919044,0.33150790442662575,0.9642555286889191,0.344002116666544,"and dismissed by the BOD. Where deemed necessary, upon the Chairman’s proposal, the BOD may",1],[0.6823123847041445,0.3491497321093904,0.9644997905382096,0.36164394434930863,"elect one or more Vice Chairpersons from among our members. The Chairman of the BOD shall not",1],[0.6823123847041445,0.366791559792155,0.8912324805421038,0.37928577203207325,"concurrently hold 