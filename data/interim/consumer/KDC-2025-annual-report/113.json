 trình",1],[0.07805231457580451,0.7702537857455138,0.4512301669247981,0.7822230285712126,"sản xuất hoặc cung cấp sản phẩm, dịch vụ riêng lẻ, một nhóm các sản phẩm hoặc các dịch vụ có",1],[0.07805231457580451,0.7853709394343713,0.4512277146790572,0.7973401822600702,"liên quan mà bộ phận này có rủi ro vì lợi ích kinh tế khác với các bộ phận kinh doanh khác. Theo",1],[0.07805231457580451,0.800488093123229,0.451230166924798,0.8124573359489279,"đó. hoạt động theo lĩnh vực kinh doanh của Tập đoàn bao gồm ngành dầu ăn. ngành hàng thực",1],[0.07805231457580451,0.8156052468120867,0.19982266391326797,0.8275744896377856,"phẩm và các ngành hàng khác.",1],[0.07805231457580451,0.8450136764348287,0.4512277146790572,0.8569829192605276,"Bộ phận theo lĩnh vực địa lý là một bộ phận có thể phân biệt được, tham gia vào quá trình sản xuất",1],[0.07805231457580451,0.8601308301236864,0.4512285320943035,0.8721000729493853,"hoặc cung cấp sản phẩm, dịch vụ trong phạm vi một môi trường kinh tế cụ thể mà bộ phận này có",1],[0.07805231457580451,0.8752479838125441,0.45122444501806946,0.887217226638243,"có rủi ro vì lợi ích kinh tế khác với các bộ phận kinh doanh trong các môi trường kinh tế khác. Toàn",1],[0.07805231457580451,0.8903651375014017,0.45122934950955096,0.9023343803271006,"bộ hoạt động kinh doanh của Tập đoàn phát sinh tại Việt Nam. Vì vậy, Tập đoàn xác định không",1],[0.07805231457580451,0.9054822911902594,0.35246678712786095,0.9174515340159582,"có sự khác biệt về khu vực địa lý cho toàn bộ hoạt động của Tập đoàn.",1],[0.5487854069867493,0.1607081256039745,0.5630738255033557,0.17267736842967332,"34.",1],[0.5780570469798657,0.1607081256039745,0.7472865255549817,0.17267736842967332,"THÔNG TIN THEO BỘ PHẬN (TIẾP THEO)",1],[0.5780570469798657,0.19011655522671653,0.9512308122526246,0.2020857980524154,"Báo cáo bộ phận bao gồm các khoản mục phân bổ trực tiếp cho một bộ phận cũng như các bộ",1],[0.5780570469798657,0.20523370891557421,0.9512324470831184,0.21720295174127308,"phận được phân chia theo một cơ sở hợp lý. Các khoản mục không được phân bổ bao gồm tài",1],[0.5780570469798657,0.2203508626044319,0.9512308122526243,0.23232010543013076,"sản, nợ phải trả, doanh thu từ hoạt động tài chính, chi phí tài chính, chi phí bán hàng, chi phí quản",1],[0.5780570469798657,0.2354680162932896,0.8310307176045426,0.24743725911898845,"lý doanh nghiệp, lãi hoặc lỗ khác và thuế Thu nhập doanh nghiệp.",1],[0.5780570469798657,0.26487644591603166,0.9512308122526243,0.2768456887417305,"Tập đoàn lựa chọn các bộ phận theo lĩnh vực kinh doanh là bộ phận báo cáo chính yếu bao gồm",1],[0.5780570469798657,0.27999359960488934,0.8024784030287382,0.2919628424305882,"ngành dầu ăn, ngành thực phẩm và các ngành hàng khác.",1],[0.5780570469798657,0.3094020292276314,0.9512316296678708,0.32137127205333027,"Thông tin về doanh thu, lợi nhuận và một số tài sản và công nợ của bộ phận theo lĩnh vực",1],[0.5780570469798658,0.32451918291648907,0.7102494407158835,0.33648842574218796,"kinh doanh của Tập đoàn như sau:",1],[0.9338288590604027,0.33963633660534676,0.9512316296678713,0.35160557943104565,"VND",1],[0.6722435036998795,0.37299033263155773,0.7219548270521425,0.3836996551598146,"Ngành dầu ăn",1],[0.7518313543279985,0.3601391455976495,0.7951285493030459,0.3708484681259064,"Ngành hàng",1],[0.7566437790397521,0.37299033263155773,0.795128549303046,0.3836996551598146,"thực phẩm",1],[0.8146488556186542,0.37299033263155773,0.8731805197040097,0.3836996551598146,"Các ngành khác",1],[0.9126453278265358,0.37299033263155773,0.9512324901049733,0.3836996551598146,"Tổng cộng",1],[0.5804901910170367,0.3919138315310174,0.6121878334193771,0.40262315405927424,"Năm nay",1],[0.5804901910170367,0.41083745642250674,0.6483834107726726,0.4215467789507636,"Doanh thu bộ phận",1],[0.5804901910170367,0.4297610813139961,0.6402213044226468,0.44047040384225294,"Doanh thu từ bán",1],[0.5804901910170367,0.44488264472389477,0.6434978489072449,0.4555919672521517,"hàng ra bên ngoài",1],[0.6543689554293581,0.437320603098648,0.