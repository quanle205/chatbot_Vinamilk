[[0.048780674582688005,0.1071431181263474,0.4251024780588537,0.13990104585983898,"Kết quả hoạt động kinh doanh (tiếp theo)",1],[0.048780674582688005,0.16930884552243233,0.3358087248322148,0.18946757028150407,"Báo cáo đánh giá của ban Tổng Giám đốc",1],[0.048780674582688005,0.21978314251840425,0.33247281018757513,0.2317523853441031,"ĐÁNH GIÁ TÌNH HÌNH HOẠT ĐỘNG CỦA TẬP ĐOÀN TRONG NĂM 2025",1],[0.05896704525899156,0.25103395359209585,0.34461276286353465,0.26362433712443356,"1. Một số điểm nổi bật tác động đến hoạt động sản xuất kinh doanh",1],[0.05896704525899156,0.636487669790009,0.1555608862502151,0.6490780533223468,"2. Các chỉ tiêu chủ yếu",1],[0.04856169334021683,0.28480863700562303,0.052305455171226985,0.29677787983132187,"y",1],[0.058321631388745486,0.28480863700562303,0.4512294355532608,0.29677787983132187,"Năm 2025, nền kinh tế thế giới chứng kiến nhiều diễn biến bất ổn và bất định: cuộc chiến thuế quan",1],[0.058321631388745486,0.2991717283964616,0.4512261658922732,0.3111409712221605,"kéo dài, xung đột quân sự gia tăng, căng thẳng thương mại Hoa Kỳ - Trung Quốc chưa giảm nhiệt,",1],[0.058321631388745486,0.31353481978730025,0.4512261658922732,0.3255040626129991,"kinh tế toàn cầu tăng trưởng chậm, lạm phát toàn cầu giảm nhưng vẫn ở mức cao ở một số nước",1],[0.058321631388745486,0.3278979111781388,0.45122534847702617,0.33986715400383766,"phát triển,… cùng với đó là biến đổi khí hậu và thiên tai. Mặc dù chịu nhiều tác động từ những biến",1],[0.058321631388745486,0.3422610025689774,0.4512237136465322,0.35423024539467624,"số không thuận lợi của tình hình thế giới cùng thiên tai, bão lũ gây hậu quả nghiêm trọng, song với",1],[0.058321631388745486,0.356624093959816,0.4512261658922736,0.3685933367855148,"nỗ lực, cố gắng rất lớn của Đảng, Chính phủ và Quốc hội, Việt Nam đã giữ vững được ổn định kinh tế",1],[0.058321631388745486,0.37098718535065456,0.45122698330752037,0.3829564281763534,"vĩ mô, kiểm soát được lạm phát. Tuy nhiên, trong năm, đồng Việt Nam nối tiếp chuỗi mất giá so với",1],[0.058321631388745486,0.38535027674149314,0.4512237136465322,0.39731951956719197,"USD; tiêu dùng nội địa năm 2025 có sự phục hồi đáng kể, niềm tin tăng cao nhưng sức mua thực tế",1],[0.058321631388745486,0.3997133681323317,0.42751540182412656,0.4116826109580306,"chưa tăng tương xứng phản ánh xu hướng chi tiêu thận trọng, ưu tiên tiết kiệm đề phòng rủi ro.",1],[0.04856169334021684,0.4212220974901126,0.052305455171226985,0.4331913403158114,"y",1],[0.058321631388745486,0.4212220974901126,0.4512253484770264,0.4331913403158114,"Tập đoàn KIDO liên tục nỗ lực thực hiện các chiến lược đề ra trong năm 2025: Chủ động nâng cấp",1],[0.058321631388745486,0.43558518888095116,0.4512261658922736,0.44755443170665,"chất lượng và mẫu mã sản phẩm, tận dụng lợi thế thương hiệu ra mắt các sản phẩm mới, khai thác",1],[0.058321631388745486,0.44994828027178974,0.45122453106177945,0.4619175230974886,"các kênh bán hàng còn dư địa tăng trưởng, liên tục mở rộng các ngành hàng, phục vụ đa nhu cầu của",1],[0.058321631388745486,0.4643113716626283,0.45122698330752076,0.4762806144883272,"người tiêu dùng. Trong đó, ngành dầu ăn – bơ – gia vị đã cải tiến, ra mắt các sản phẩm mới, triển khai",1],[0.058321631388745486,0.47867446305346695,0.4512286181380146,0.4906437058791658,"nhiều hoạt động duy trì sự hiện diện thương hiệu từ offline đến online. Ngành bánh đã quy hoạch lại",1],[0.058321631388745486,0.4930375544443055,0.45122861813801424,0.5050067972700044,"kênh phân phối, tập trung phát triển các sản phẩm chủ lực, ra mắt hàng loạt sản phẩm mới phục vụ",1],[0.058321631388745486,0.5074006458351441,0.45122534847702667,0.519369888660843,"đa phân khúc. Ngành bánh trung thu tăng cường xây dựng kênh phân phối, tập trung khai thác phân",1],[0.058321631388745486,0.5217637372259827,0.45122616589227343,0.5337329800516816,"khúc B2B. Ngành hàng hấp triển khai các hoạt động kích thích tiêu dùng, đa dạng hóa danh mục sản",1],[0.058321631388745486,0.5361268286168213,0.21601738082946143,0.5480960714425201,"phẩm, nâng cấp và trẻ hóa thương hiệu.",1],[0.04856169334021684,0.5576355579746021,0.052305455171226985,0.569604800800301,"y",1],[0.058321631388745486,0.5576355579746021,0.4512261658922735,0.569604800800301,"Dù đã triển khai nhiều hoạt động, thúc đẩy sự tăng trưởng và phát triển của các ngành hàng nhưng",1],[0.058321631388745486,0.5719986493654408,0.4512253484770265,0.5839678921911395,"trước bối cảnh khó khăn chung của nền kinh tế, tốc độ tăng trưởng của Tập đoàn vẫn chưa thể đạt",1],[0.058321631388745486,0.5863617407562793,0.1300089485458613,0.5983309835819781,"được như kỳ vọng.",1],[0.04877422130442265,0.7671092766671577,0.0525179831354328,0.7790785194928564,"y",1],[0.0585341593529513,0.7671092766671577,0.4512253484770263,0.7790785194928564,"Đứng trước bối cảnh khó khăn chung của nền kinh tế, các doanh nghiệp Việt Nam nói chung và Tập",1],[0.0585341593529513,0.7814723680579962,0.45122453106177923,0.793441610883695,"đoàn KIDO nói riêng đều chịu áp lực, ảnh hưởng đến tình hình hoạt động kinh doanh, kéo theo doanh",1],[0.0585341593529513,0.7958354594488348,0.32009069007055596,0.8078047022745336,"thu thuần và lợi nhuận trước thuế chưa hoàn thành kế hoạch đề ra.",1],[0.04877422130442265,0.8244898267735579,0.0525179831354328,0.8364590695992568,"y",1],[0.0585341593529513,0.8244898267735579,0.45122534847702656,0.8364590695992568,"Tuy nhiên, với nền tảng phát triển bền vững kết hợp với việc linh hoạt điều tiết kinh doanh phù hợp",1],[0.0585341593529513,0.8388529181643964,0.45122453106177973,0.8508221609900953,"cho từng giai đoạn, KIDO đã mạnh mẽ tái cấu trúc và mở rộng các ngành hàng, phát huy tối đa các",1],[0.0585341593529513,0.853216009555235,0.20570078299776287,0.8651852523809339,"thế mạnh bên trong và bên ngoài. Đư",1],[0.20570078299776284,0.853216009555235,0.21102215625537768,0.8651852523809339,"ợ",1],[0.21102215625537768,0.853216009555235,0.278310144553433,0.8651852523809339,"c sự ủng hộ tin tư",1],[0.2783101445534331,0.853216009555235,0.283631517811048,0.86