[[0.048780674582688005,0.1071431181263474,0.4251024780588537,0.13990104585983898,"Kết quả hoạt động kinh doanh (tiếp theo)",1],[0.048780674582688005,0.20244071760020466,0.45122607984856306,0.2144099604259035,"Năm 2025 là một năm nhiều thử thách khi nước ta liên tục đối mặt với thiên tai, bão lụt gây thiệt hại",1],[0.048780674582688005,0.21680380899104323,0.45122444501806935,0.22877305181674207,"nặng nề chưa từng có, cùng với đó là những chính sách thay đổi về thuế hộ, cá nhân kinh doanh gây ảnh",1],[0.048780674582688005,0.2311669003818818,0.451228532094304,0.24313614320758067,"hưởng trực tiếp tới đầu ra của Tập đoàn dẫn đến kết quả kinh doanh của Tập đoàn chưa đạt được như",1],[0.048780674582688005,0.24552999177272042,0.45122934950955085,0.2574992345984193,"kế hoạch đề ra. Tuy nhiên, Tập đoàn đã đẩy mạnh nhiều hoạt động hỗ trợ nhằm phù hợp với tình hình",1],[0.048780674582688005,0.25989308316355897,0.4512277146790573,0.27186232598925786,"kinh tế và cải thiện kết quả kinh doanh. Nhờ đó, lợi nhuận sau thuế của Tập đoàn năm 2025 đạt 587 tỷ,",1],[0.048780674582688005,0.2742561745543976,0.20903493374634316,0.28622541738009644,"tăng gần 9 lần so với cùng kỳ năm trước.",1],[0.048780674582688005,0.17718082754084977,0.24678446050593703,0.1897800305152696,"LỢI NHUẬN TRƯỚC THUẾ VÀ LỢI NHUẬN SAU THUẾ",1],[0.07273016692479779,0.38300329721141846,0.12003011529857169,0.4283604279193299,"727",1],[0.27778953708483906,0.38395579695628457,0.3258329031147823,0.429312927664196,"587",1],[0.27681621063500256,0.3427085262586289,0.3719461366374118,0.3553077292330487,"LỢI NHUẬN SAU THUẾ",1],[0.27681621063500256,0.35770157779818856,0.316518069179143,0.3696708206238874,"(Tỷ đồng)",1],[0.07133247289623129,0.3427085262586289,0.179689898468422,0.3553077292330487,"LỢI NHUẬN TRƯỚC THUẾ",1],[0.07133247289623129,0.35770157779818856,0.11103433144037171,0.3696708206238874,"(Tỷ đồng)",1],[0.5642993460678024,0.15061175430042298,0.7603596627086562,0.1625809971261218,"Với thế mạnh về nguồn lực tài chính, c