5,0.3555332137602359,0.5083333219696969,"Quản lý rủi ro về lãi suất",1],[0.18058823651960787,0.5196258503787878,0.908074109486896,0.5327272708333333,"Rủi ro lãi suất của Công ty phát sinh chủ yếu từ các khoản vay đã ký kết. Để giảm thiểu rủi ro này, Công ty",1],[0.18058823651960787,0.5368985681818181,0.9082214704092683,0.5499999886363636,"đã ước tính ảnh hưởng của chi phí lãi vay đến kết quả kinh doanh từng thời kỳ cũng như phân tích, dự báo",1],[0.18058823651960787,0.5541712859848484,0.9079603270473697,0.567272706439394,"để lựa chọn các thời điểm trả nợ thích hợp. Ban Tổng Giám đốc cho rằng rủi ro về biến động lãi suất ngoài",1],[0.18058823651960787,0.5714440615530303,0.39969796363665966,0.5845454820075757,"dự tính của Công ty ở mức thấp.",1],[0.18058823651960787,0.5959895,0.34243882568578743,0.6090909204545455,"Quản lý rủi ro về tỷ giá",1],[0.18058823651960787,0.6203834488636364,0.9082969721274268,0.6334848693181818,"Công ty có giao dịch bằng ngoại tệ. Do đó, Công ty sẽ chịu rủi ro khi có biến động về tỷ giá. Rủi ro này",1],[0.18058823651960787,0.6376561666666666,0.9082369018865238,0.650757587121212,"được Công ty quản lý thông qua các biện pháp như: duy trì hợp lý cơ cấu vay ngoại tệ và nội tệ, tối ưu hóa",1],[0.18058823651960787,0.654928884469697,0.9081082839641484,0.6680303049242424,"thời hạn thanh toán các khoản nợ, lựa chọn thời điểm mua và thanh toán các khoản ngoại tệ phù hợp, dự",1],[0.18058823651960787,0.6723531505681818,0.9081139797357886,0.6854545710227272,"báo tỷ giá ngoại tệ trong tương lai, sử dụng tối ưu nguồn tiền hiện có để cân bằng giữa rủi ro tỷ giá và rủi",1],[0.18058823651960787,0.6896258683712121,0.2865188504069708,0.7027272888257575,"ro thanh khoản.",1],[0.18058823651960787,0.7140198172348484,0.8109488543027071,0.7271212376893939,"Giá trị ghi sổ của các công cụ tài chính có gốc ngoại tệ tại thời điểm cuối kỳ kế toán như sau:",1],[0.6633236493540844,0.7418644296656742,0.7390656268419437,0.7546873918159887,"30/06/2025",1],[0.8248395750173143,0.