982,0.3422144435858324,0.507855895663329,"Quản lý rủi ro về lãi suất",1],[0.1511871468024916,0.5191202651177708,0.9460741386516506,0.5322336172184016,"Rủi ro lãi suất của Công ty phát sinh chủ yếu từ các khoản vay đã ký kết. Để giảm thiểu rủi ro này, Công ty",1],[0.1511871468024916,0.5363643231301001,0.9460725993320752,0.5494776752307309,"đã ước tính ảnh hưởng của chi phí lãi vay đến kết quả kinh doanh từng thời kỳ cũng như phân tích, dự báo",1],[0.1511871468024916,0.5536083811424296,0.9459525880431935,0.5667217332430604,"để lựa chọn các thời điểm trả nợ thích hợp. Ban Tổng Giám đốc cho rằng rủi ro về biến động lãi suất ngoài",1],[0.1511871468024916,0.5708524391547589,0.39067710144538004,0.5839657912553897,"dự tính của Công ty ở mức thấp.",1],[0.1511871468024916,0.5953744075829384,0.3279012937864117,0.6084877596835692,"Quản lý rủi ro về tỷ giá",1],[0.1511871468024916,0.619752129138011,0.9460423693211216,0.6328654812386417,"Công ty có giao dịch bằng ngoại tệ. Do đó, Công ty sẽ chịu rủi ro khi có biến động về tỷ giá. Rủi ro này",1],[0.1511871468024916,0.6369961871503405,0.9460419613087043,0.6501095392509711,"được Công ty quản lý thông qua các biện pháp như: duy trì hợp lý cơ cấu vay ngoại tệ và nội tệ, tối ưu hóa",1],[0.1511871468024916,0.6542402451626699,0.946041423474153,0.6673535972633006,"thời hạn thanh toán các khoản nợ, lựa chọn thời điểm mua và thanh toán các khoản ngoại tệ phù hợp, dự",1],[0.1511871468024916,0.6716285500481061,0.9459171836929426,0.6847419021487368,"báo tỷ giá ngoại tệ trong tương lai, sử dụng tối ưu nguồn tiền hiện có để cân bằng giữa rủi ro tỷ giá và rủi",1],[0.1511871468024916,0.6888726080604355,0.26687721325905966,0.7019859601610662,"ro thanh khoản.",1],[0.1511871468024916,0.713250329615508,0.8401487366532502,0.7263636817161387,"Giá trị ghi sổ của các công cụ tài chính có gốc ngoại tệ tại thời điểm cuối kỳ kế toán như sau:",1],[0.6781362527634242,0.741059067099027,0.7607720922731641,0.7538766560952143,"31/03/2025",1],[0.8545237581189231,0.7