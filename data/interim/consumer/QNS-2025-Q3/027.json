48484801136364,"Quản lý rủi ro về lãi suất",1],[0.1803921531862745,0.5176561363636363,0.9082104988150002,0.5307575568181817,"Rủi ro lãi suất của Công ty phát sinh chủ yếu từ các khoản vay đã ký kết. Để giảm thiểu rủi ro này, Công ty",1],[0.1803921531862745,0.536444040719697,0.9083403088448709,0.5495454611742424,"đã ước tính ảnh hưởng của chi phí lãi vay đến kết quả kinh doanh từng thời kỳ cũng như phân tích, dự báo",1],[0.1803921531862745,0.5552318873106061,0.9082526870704692,0.5683333077651516,"để lựa chọn các thời điểm trả nợ thích hợp. Ban Tổng Giám đốc cho rằng rủi ro về biến động lãi suất ngoài",1],[0.1803921531862745,0.5740197916666666,0.39963467066127756,0.5871212121212122,"dự tính của Công ty ở mức thấp.",1],[0.1803921531862745,0.5999288683712122,0.3422960571988672,0.6130302888257576,"Quản lý rủi ro về tỷ giá",1],[0.1803921531862745,0.6259894933712121,0.9082479185387593,0.6390909138257576,"Công ty có giao dịch bằng ngoại tệ. Do đó, Công ty sẽ chịu rủi ro khi có biến động về tỷ giá. Rủi ro này",1],[0.1803921531862745,0.644625850378788,0.9081984450349887,0.6577272708333334,"được Công ty quản lý thông qua các biện pháp như: duy trì hợp lý cơ cấu vay ngoại tệ và nội tệ, tối ưu hóa",1],[0.1803921531862745,0.6634137537878789,0.9082026174536086,0.6765151742424242,"thời hạn thanh toán các khoản nợ, lựa chọn thời điểm mua và thanh toán các khoản ngoại tệ phù hợp, dự",1],[0.1803921531862745,0.6823531477272728,0.9082841461380694,0.6954545681818182,"báo tỷ giá ngoại tệ trong tương lai, sử dụng tối ưu nguồn tiền hiện có để cân bằng giữa rủi ro tỷ giá và rủi",1],[0.1803921531862745,0.7011409943181819,0.2863227670736374,0.7142424147727273,"ro thanh khoản.",1],[0.1803921531862745,0.726898581439394,0.8108001251426729,0.7400000018939393,"Giá trị ghi sổ của các công cụ tài chính có gốc ngoại tệ tại thời điểm cuối kỳ kế toán như sau:",1],[0.6631309879008174,0.7564099774730909,0.7388729653886768,0.7692329396234053,"30/09/2025",1],[0.82464186438872,0.7564099774730909,0.9003838418